# Optional server-side AI gateway; never put API keys in browser code.
# Contract is described in README.md. Without this, matching uses transparent rules.
RADAR_AI_URL=
RADAR_AI_KEY=

# Google Calendar read-only availability connection. Register a Web OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4317/api/calendar/google/callback
# A base64url-encoded random 32-byte key, generated and kept on the server.
RADAR_TOKEN_ENCRYPTION_KEY=

# Email intake: example address is a design proposal, not an active mailbox.
RADAR_INTAKE_EMAIL=events@trojanradar.app
RADAR_EMAIL_INTAKE_ACTIVE=false
RADAR_MAIL_WEBHOOK_SECRET=
RADAR_TRUSTED_SENDERS=
RADAR_CONTACT_EMAIL=

# Optional: browser-restricted Maps JavaScript API key (public by design).
# Restrict HTTP referrers to your localhost / deployed domain and API to Maps JavaScript.
RADAR_GOOGLE_MAPS_BROWSER_KEY=
